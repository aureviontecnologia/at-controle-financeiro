# Variaveis publicas incorporadas ao app. Use uma publishable key; ela e segura no cliente somente com RLS correto.
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICAVEL

# Segredos abaixo pertencem SOMENTE ao Supabase Edge Functions / ambiente de servidor.
# Nunca use prefixo EXPO_PUBLIC_ neles e nunca os inclua no app.
GROQ_API_KEY=CONFIGURE_NO_BACKEND
GROQ_MODEL=openai/gpt-oss-20b

# URL confiavel usada pelo backend para validacao, quando aplicavel.
APP_ORIGIN=aurevion://
