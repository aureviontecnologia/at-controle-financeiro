{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "at-controle-financeiro-aurevion",
	"main": "./cloudflare/worker.mjs",
	"compatibility_date": "2026-08-30",
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/*",
			"!/_expo/static/*",
			"!/pwa-192.png",
			"!/pwa-512.png",
			"!/pwa-maskable-512.png",
			"!/apple-touch-icon.png"
		]
	},
	"d1_databases": [
		{
			"binding": "PUSH_DB",
			"database_name": "at-finance-notifications",
			"database_id": "4281b6aa-9d81-46f5-b1d7-c4c880a3333a"
		}
	]
}
